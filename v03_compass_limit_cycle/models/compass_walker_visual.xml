<mujoco model="passive_compass_limit_cycle_visual">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.001" integrator="RK4" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.82 0.88 0.86" rgb2="0.96 0.94 0.88" width="512" height="512"/>
    <material name="ramp_mat" texture="grid" texrepeat="5 1" rgba="0.76 0.82 0.78 1"/>
    <material name="left_mat" rgba="0.05 0.47 0.57 1"/>
    <material name="right_mat" rgba="0.86 0.29 0.21 1"/>
    <material name="hip_mat" rgba="0.08 0.12 0.20 1"/>
    <material name="foot_mat" rgba="0.10 0.10 0.10 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="-2 -3 5" dir="0.3 0.5 -1" diffuse="0.85 0.85 0.85"/>
    <camera name="track" pos="1.7 -4.0 1.35" xyaxes="1 0 0 0 0.25 1"/>
    <geom name="ramp" type="plane" pos="0 0 0" euler="0 5 0" size="80 2.0 0.08" material="ramp_mat" contype="1" conaffinity="1"/>

    <body name="hip" pos="0 0 0">
      <joint name="hip_x" type="slide" axis="1 0 0" damping="0"/>
      <joint name="hip_z" type="slide" axis="0 0 1" damping="0"/>
      <geom name="hip_mass" type="sphere" size="0.075" mass="4.5" material="hip_mat" contype="0" conaffinity="0"/>

      <body name="left_leg" pos="0 -0.095 0">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-70 70" limited="true"/>
        <geom name="left_shank" type="capsule" fromto="0 0 -0.07 0 0 -1.0" size="0.026" mass="0.24" material="left_mat" contype="0" conaffinity="0"/>
        <geom name="left_foot" type="sphere" pos="0 0 -1.0" size="0.04" mass="0.05" material="foot_mat" contype="0" conaffinity="0"/>
      </body>

      <body name="right_leg" pos="0 0.095 0">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-70 70" limited="true"/>
        <geom name="right_shank" type="capsule" fromto="0 0 -0.07 0 0 -1.0" size="0.026" mass="0.24" material="right_mat" contype="0" conaffinity="0"/>
        <geom name="right_foot" type="sphere" pos="0 0 -1.0" size="0.04" mass="0.05" material="foot_mat" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>
</mujoco>
