mdb.Model(modelType=STANDARD_EXPLICIT, name='HeelStrike')
del mdb.models['Model-1']
mdb.models['HeelStrike'].ConstrainedSketch(name='heelSketch', sheetSize=0.2)
mdb.models['HeelStrike'].sketches['heelSketch'].ArcByCenterEnds(center=(0.0, 
    0.0), direction=CLOCKWISE, point1=(0.0, 0.04), point2=(0.0, -0.04))
mdb.models['HeelStrike'].sketches['heelSketch'].Line(point1=(0.0, -0.04), 
    point2=(0.0, 0.04))
mdb.models['HeelStrike'].Part(dimensionality=AXISYMMETRIC, name='Heel', type=
    DEFORMABLE_BODY)
mdb.models['HeelStrike'].parts['Heel'].BaseShell(sketch=
    mdb.models['HeelStrike'].sketches['heelSketch'])
