# hw-1 项目环境变量配置模板
# 复制此文件为 .env 并根据本地环境修改

# ============================================
# 项目路径配置
# ============================================
HW1_PROJECT_ROOT=D:\Dunna\Documents\hw-1
HW1_DATA_DIR=D:\Dunna\Documents\hw-1\data_storage
HW1_OUTPUT_DIR=D:\Dunna\Documents\hw-1\out

# ============================================
# Python 环境配置
# ============================================
# 主要虚拟环境（用于 MuJoCo 仿真）
HW1_VENV_MUJOCO=D:\Dunna\Documents\hw-1\.venv-mujoco
# Codex 环境（Claude Code 内部使用）
HW1_VENV_CODEX=D:\Dunna\Documents\hw-1\.venv-codex

# Python 解释器路径（自动从虚拟环境推导，通常不需要手动设置）
# PYTHON_EXECUTABLE=D:\Dunna\Documents\hw-1\.venv-mujoco\Scripts\python.exe

# ============================================
# MuJoCo 配置
# ============================================
# MuJoCo 模型文件路径
MUJOCO_MODEL_DIR=D:\Dunna\Documents\hw-1\common\models
# MuJoCo 渲染设置
MUJOCO_GL=egl
# 禁用 MuJoCo 警告（可选）
# MUJOCO_DISABLE_WARNINGS=1

# ============================================
# 仿真参数默认值
# ============================================
# 默认仿真时长（秒）
HW1_DEFAULT_DURATION=10.0
# 默认时间步长（秒）
HW1_DEFAULT_TIMESTEP=0.001
# 默认渲染帧率
HW1_DEFAULT_FPS=30

# ============================================
# 测试配置
# ============================================
# pytest 并行进程数
PYTEST_XDIST_WORKERS=auto
# 测试超时时间（秒）
PYTEST_TIMEOUT=300
# 跳过慢速测试（开发时设为 true）
SKIP_SLOW_TESTS=false

# ============================================
# 性能分析配置
# ============================================
# 启用性能分析（开发调试用）
ENABLE_PROFILING=false
# 性能分析输出目录
PROFILING_OUTPUT_DIR=D:\Dunna\Documents\hw-1\profiling_results

# ============================================
# 日志配置
# ============================================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志输出格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# 日志文件路径
LOG_FILE=D:\Dunna\Documents\hw-1\hw1.log

# ============================================
# 可视化配置
# ============================================
# Matplotlib 后端
MPLBACKEND=TkAgg
# 是否在仿真后自动显示图形
AUTO_SHOW_PLOTS=true
# 图形保存格式
FIGURE_FORMAT=png
# 图形 DPI
FIGURE_DPI=300

# ============================================
# 版本控制与实验追踪
# ============================================
# 当前工作版本
HW1_CURRENT_VERSION=v19
# 实验追踪开关
ENABLE_EXPERIMENT_TRACKING=false
# 实验数据版本控制
DATA_VERSION_CONTROL=true

# ============================================
# CI/CD 配置
# ============================================
# CI 模式（在 CI 环境中自动设置）
CI=false
# 跳过交互式操作
NON_INTERACTIVE=false

# ============================================
# 缓存配置
# ============================================
# 启用仿真结果缓存
ENABLE_CACHE=true
# 缓存目录
CACHE_DIR=D:\Dunna\Documents\hw-1\.cache
# 缓存过期时间（小时）
CACHE_EXPIRY_HOURS=24

# ============================================
# Remotion 动画配置
# ============================================
# Remotion 项目路径
REMOTION_PROJECT_DIR=D:\Dunna\Documents\hw-1\compass-gait-remotion
# Node.js 路径（如果不在 PATH 中）
# NODE_PATH=C:\Program Files\nodejs\node.exe

# ============================================
# MATLAB 配置（如果使用 MATLAB 互操作）
# ============================================
# MATLAB 安装路径
# MATLAB_ROOT=C:\Program Files\MATLAB\R2023b
# MATLAB 数据目录
MATLAB_DATA_DIR=D:\Dunna\Documents\hw-1\matlab-v01-v13-gait

# ============================================
# 开发者工具配置
# ============================================
# 启用调试模式
DEBUG=false
# 详细输出
VERBOSE=false
# 启用代码覆盖率报告
COVERAGE_ENABLED=false
